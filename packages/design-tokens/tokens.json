{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "name": "egna-enelaklo",
  "version": "0.1.0",
  "description": "Brand tokens for egna-enelaklo. Never hard-code these values in pages: use the Tailwind preset or the generated CSS variables.",
  "color": {
    "brand": {
      "50": "#E1F2F1",
      "100": "#CFE8E6",
      "500": "#0E7C7B",
      "700": "#0A5E5D"
    },
    "ink": {
      "500": "#5A696D",
      "700": "#3B4A4F",
      "900": "#1F2A2E"
    },
    "line": {
      "DEFAULT": "#DCE4E4"
    },
    "surface": {
      "DEFAULT": "#FFFFFF"
    },
    "canvas": {
      "DEFAULT": "#F4F7F7"
    },
    "warning": {
      "bg": "#FCEFD0",
      "text": "#6B4400"
    },
    "danger": {
      "bg": "#FBE0E0",
      "text": "#8A1C1C"
    },
    "chip": {
      "bg": "#E8EDED",
      "text": "#3B4A4F"
    },
    "logo": {
      "speed": "#BFE3E1"
    }
  },
  "font": {
    "heading": {
      "family": "Sora, 'Noto Sans Ethiopic', system-ui, -apple-system, sans-serif",
      "weights": [600, 700]
    },
    "body": {
      "family": "Figtree, 'Noto Sans Ethiopic', system-ui, -apple-system, sans-serif",
      "weights": [400, 500, 600, 700]
    },
    "ethiopic": {
      "family": "'Noto Sans Ethiopic', system-ui, -apple-system, sans-serif",
      "weights": [400, 600]
    }
  },
  "fontSize": {
    "pageTitle": {
      "size": "28px",
      "lineHeight": "34px",
      "letterSpacing": "-0.5px",
      "fontWeight": 700
    },
    "sectionTitle": {
      "size": "20px",
      "lineHeight": "26px",
      "letterSpacing": "-0.2px",
      "fontWeight": 700
    },
    "body": {
      "size": "15px",
      "lineHeight": "24px",
      "fontWeight": 400
    },
    "label": {
      "size": "13px",
      "lineHeight": "18px",
      "fontWeight": 600
    },
    "chip": {
      "size": "12px",
      "lineHeight": "16px",
      "fontWeight": 700
    }
  },
  "radius": {
    "control": "10px",
    "panel": "12px",
    "card": "16px",
    "pill": "999px"
  },
  "control": {
    "minHeight": "44px",
    "inputHeight": "46px",
    "primaryButtonHeight": "48px",
    "largeButtonHeight": "56px"
  },
  "focus": {
    "ringWidth": "3px",
    "ringColor": "#0E7C7B",
    "ringOffset": "2px"
  },
  "statusChip": {
    "fontSize": "12px",
    "fontWeight": 700,
    "radius": "999px",
    "paddingX": "12px",
    "paddingY": "5px"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  }
}
