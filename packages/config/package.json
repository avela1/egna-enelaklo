{
  "name": "@egna-enelaklo/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript, ESLint and Prettier configuration for the egna-enelaklo monorepo",
  "type": "module",
  "files": [
    "tsconfig",
    "eslint",
    "prettier"
  ],
  "exports": {
