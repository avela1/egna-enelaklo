{
  "name": "@egna-enelaklo/web",
  "version": "0.1.0",
  "private": true,
  "description": "egna-enelaklo web application (customer portal, tasker portal and staff console)",
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @egna-enelaklo/design-tokens",
    "dev": "vite",
    "prebuild": "npm run build --workspace @egna-enelaklo/design-tokens",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
