# egna-enelaklo API environment.
# Copy to `apps/api/.env`. NEVER commit a real .env file.

# development | test | production
NODE_ENV=development

# Port the NestJS API listens on.
PORT=3000

# Global route prefix: http://localhost:3000/api/v1
API_PREFIX=api/v1

# PostgreSQL connection string used by Prisma.
# If the host already runs a PostgreSQL on 5432, set POSTGRES_HOST_PORT in the
# root .env to a free port and use the same port here.
DATABASE_URL=postgresql://egna:egna@localhost:5432/egna_dev?schema=public

# Comma separated list of browser origins allowed to call the API with cookies.
WEB_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Signs the httpOnly session cookie (Phase 1). Minimum 32 characters.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional cookie domain, e.g. .egna-enelaklo.et
COOKIE_DOMAIN=

# Mail (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=egna-enelaklo <no-reply@egna-enelaklo.local>

# Object storage (MinIO locally) — the bucket is PRIVATE
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=egna-private
S3_ACCESS_KEY_ID=egna
S3_SECRET_ACCESS_KEY=egna-secret
S3_FORCE_PATH_STYLE=true
