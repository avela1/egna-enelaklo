{
  "name": "@egna-enelaklo/api",
  "version": "0.1.0",
  "private": true,
  "description": "egna-enelaklo REST API (NestJS)",
  "scripts": {
    "prebuild": "node scripts/prisma-generate.mjs",
    "build": "nest build",
    "predev": "node scripts/prisma-generate.mjs",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "pretypecheck": "node scripts/prisma-generate.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build --workspace @egna-enelaklo/shared && node scripts/prisma-generate.mjs",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch --config jest.config.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "npm run build --workspace @egna-enelaklo/shared && node scripts/prisma-generate.mjs && prisma db seed",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node -r ts-node/register/transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "@egna-enelaklo/shared": "*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/swagger": "^8.0.1",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^5.21.1",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^16.6.1",
    "helmet": "^8.0.0",
    "nodemailer": "^6.10.1",
    "pino": "^9.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@egna-enelaklo/config": "*",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.4",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.8.6",
    "@types/nodemailer": "^6.4.24",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.14.0",
    "jest": "^29.7.0",
    "prisma": "^5.21.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
