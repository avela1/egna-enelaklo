# egna-enelaklo — root environment template.
#
# Copy to `.env` and adjust. NEVER commit a real .env file.
# The API and the web app each keep their own .env.example with the same
# variables scoped to what they need.

# ---------------------------------------------------------------------------
# Local services (infra/docker-compose.yml)
# ---------------------------------------------------------------------------

# Host port for the PostgreSQL container. Change it to 5433 (or any free port)
# when the machine already runs a PostgreSQL on 5432, and use the same port in
# DATABASE_URL above.
POSTGRES_HOST_PORT=5432

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the NestJS API listens on.
PORT=3000

# Global route prefix. Every REST endpoint lives under http://localhost:3000/api/v1
API_PREFIX=api/v1

# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://egna:egna@localhost:5432/egna_dev?schema=public

# Comma separated list of browser origins allowed to call the API with cookies.
WEB_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Password of the seeded development accounts (admin@egna.test, ops@egna.test,
# finance@egna.test, tasker@egna.test, customer@egna.test). At least 10
# characters. The seed refuses to run when NODE_ENV=production.
SEED_PASSWORD=change-this-seed-password

# ---------------------------------------------------------------------------
# Mail (Mailpit locally)
# ---------------------------------------------------------------------------

# Use 127.0.0.1 rather than localhost: on some Windows setups resolving
# `localhost` to IPv6 makes the SMTP client hang.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=egna-enelaklo <no-reply@egna-enelaklo.local>

# ---------------------------------------------------------------------------
# Object storage (SeaweedFS locally) — the bucket is PRIVATE
# ---------------------------------------------------------------------------

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=egna-private
S3_ACCESS_KEY_ID=egna
S3_SECRET_ACCESS_KEY=egna-secret
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------

# Base URL of the REST API, used by the web client.
VITE_API_BASE_URL=http://localhost:3000/api/v1
